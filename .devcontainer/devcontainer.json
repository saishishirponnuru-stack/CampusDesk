{
  "name": "CampusDesk",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24-bookworm",
  "forwardPorts": [5173, 5000],
  "portsAttributes": {
    "5173": { "label": "CampusDesk frontend", "onAutoForward": "notify" },
    "5000": { "label": "CampusDesk API", "onAutoForward": "silent" }
  },
  "postCreateCommand": "npm ci --prefix backend && npm ci --prefix frontend",
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
    }
  }
}
